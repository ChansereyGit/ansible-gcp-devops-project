[Unit]
Description=Nexus Repository Docker Container
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/{{ ansible_user }}/nexus
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
User={{ ansible_user }}
Group={{ ansible_user }}

[Install]
WantedBy=multi-user.target
