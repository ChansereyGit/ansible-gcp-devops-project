# Nginx configuration for Nexus (HTTP only - before SSL)
# This will be updated by certbot to add HTTPS

server {
    listen 80;
    server_name {{ nexus_domain }};

    # Allow Let's Encrypt ACME challenge
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        proxy_pass http://localhost:{{ nexus_port }};
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Nexus specific settings
        proxy_buffering off;
        
        # Timeouts for large artifact uploads
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # Max upload size for large artifacts
        client_max_body_size 500M;
    }
}

