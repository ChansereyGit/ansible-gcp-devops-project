[all:vars]
ansible_user={{ ssh_username }}
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_private_key_file={{ ssh_private_key_path }}
ansible_ssh_extra_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'

# ============================================================================
# Localhost (Ansible Controller)
# ============================================================================
[localhost]
controller ansible_connection=local

# ============================================================================
# Jenkins Servers
# ============================================================================
[jenkins]
{% for instance in instances %}
{% if 'jenkins' in instance.name %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }}
{% endif %}
{% endfor %}

# ============================================================================
# SonarQube Servers
# ============================================================================
[sonarqube]
{% for instance in instances %}
{% if 'sonarqube' in instance.name %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }}
{% endif %}
{% endfor %}

# ============================================================================
# Nexus Servers
# ============================================================================
[nexus]
{% for instance in instances %}
{% if 'nexus' in instance.name %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }}
{% endif %}
{% endfor %}

# ============================================================================
# Ansible Controller (optional - if managing itself)
# ============================================================================
[controller]
{% for instance in instances %}
{% if 'controller' in instance.name %}
{{ instance.name }} ansible_host={{ instance.networkInterfaces[0].accessConfigs[0].natIP }}
{% endif %}
{% endfor %}

